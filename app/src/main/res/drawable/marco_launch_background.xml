<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Match the first Activity frame to the artwork used by the in-app splash.
         This prevents Android's launch window from flashing a plain black frame. -->
    <item>
        <bitmap
            android:src="@drawable/marco_splash"
            android:gravity="fill" />
    </item>
</layer-list>
