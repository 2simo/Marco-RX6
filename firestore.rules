rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validGuestProfile() {
      return request.resource.data.keys().hasOnly([
          'uid', 'isAnonymous', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'isAnonymous', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isAnonymous == true;
    }

    // Anonymous sessions may keep only a minimal, self-owned profile and a
    // bounded preferences map. They cannot create arbitrary nested documents.
    match /users/{userId} {
      allow read, delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && (
          (isAnonymous() && validGuestProfile())
          || (!isAnonymous()
            && request.resource.data.keys().hasOnly([
              'uid', 'isAnonymous', 'createdAt', 'updatedAt',
              'email', 'displayName', 'photoUrl', 'bio', 'photoData'
            ])
            && request.resource.data.keys().size() <= 9
            && (!('displayName' in request.resource.data)
              || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 40))
            && (!('bio' in request.resource.data)
              || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 160))
            && (!('photoData' in request.resource.data)
              || (request.resource.data.photoData is string
                && request.resource.data.photoData.size() <= 600000)))
        );

      match /settings/preferences {
        // Preferences are cloud-synced only for non-anonymous accounts.
        allow read: if signedInAs(userId) && !isAnonymous();
        // Guests may delete their own preferences during account deletion,
        // but cannot read, create, or update cloud preferences.
        allow delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && !isAnonymous()
          && request.resource.data.keys().hasOnly(['values', 'updatedAt'])
          && request.resource.data.keys().hasAll(['values', 'updatedAt'])
          && request.resource.data.values is map
          && request.resource.data.values.keys().size() <= 20;
      }

      // No other nested collections/documents are writable.
    }

    // Public game engagement: one view document per Firebase UID and one
    // rating document per registered UID. Ratings are publicly readable so
    // aggregate scores can be calculated by the client, but only owners write.
    function validGameMetricId(gameId) {
      // The Android client derives this stable path from SHA-256(game identity).
      return gameId.matches('^[0-9a-f]{64}

    // Everything else stays denied by default.
  }
}
);
    }

    match /gameMetrics/{gameId}/views/{userId} {
      // Aggregate counts and ratings are public; writes remain UID-owned.
      allow read: if validGameMetricId(gameId);
      // A document ID equal to the Firebase UID permits one immutable view
      // per account/guest installation. Server timestamps prevent client dates.
      allow create: if validGameMetricId(gameId)
        && signedInAs(userId)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /gameMetrics/{gameId}/ratings/{userId} {
      allow read: if validGameMetricId(gameId);
      // Guests/anonymous Firebase sessions cannot rate. A registered user owns
      // exactly one rating document per game and may change its 1..5 value.
      allow create, update: if validGameMetricId(gameId)
        && signedInAs(userId)
        && !isAnonymous()
        && request.resource.data.keys().hasOnly(['uid', 'rating', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'rating', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.updatedAt == request.time;
      allow delete: if validGameMetricId(gameId)
        && signedInAs(userId)
        && !isAnonymous();
    }

    // Everything else stays denied by default.
  }
}
