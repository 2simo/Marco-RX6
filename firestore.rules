rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function follows(userId, targetUid) {
      return exists(/databases/$(database)/documents/userFollows/$(userId)/following/$(targetUid));
    }

    function mutuallyFollowing(firstUid, secondUid) {
      return firstUid != secondUid
        && follows(firstUid, secondUid)
        && follows(secondUid, firstUid);
    }

    function validGuestProfile() {
      return request.resource.data.keys().hasOnly([
          'uid', 'isAnonymous', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'isAnonymous', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isAnonymous == true;
    }

    // Anonymous sessions may keep only a minimal, self-owned profile and a
    // bounded preferences map. They cannot create arbitrary nested documents.
    match /users/{userId} {
      allow read, delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && (
          (isAnonymous() && validGuestProfile())
          || (!isAnonymous()
            && request.resource.data.keys().hasOnly([
              'uid', 'isAnonymous', 'createdAt', 'updatedAt',
              'email', 'displayName', 'photoUrl', 'bio', 'photoData', 'username',
              'publicProfile', 'showFavorites'
            ])
            && request.resource.data.keys().size() <= 12
            && (!('displayName' in request.resource.data)
              || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 40))
            && (!('bio' in request.resource.data)
              || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 160))
            && (!('username' in request.resource.data)
              || (request.resource.data.username is string
                && request.resource.data.username.size() >= 3
                && request.resource.data.username.size() <= 20
                && request.resource.data.username.matches('[A-Za-z0-9][A-Za-z0-9_]{2,19}')))
            && (!('photoData' in request.resource.data)
              || (request.resource.data.photoData is string
                && request.resource.data.photoData.size() <= 600000))
            && (!('publicProfile' in request.resource.data)
              || request.resource.data.publicProfile is bool)
            && (!('showFavorites' in request.resource.data)
              || request.resource.data.showFavorites is bool)
            )
        );

      match /settings/preferences {
        // Preferences are cloud-synced only for non-anonymous accounts.
        allow read: if signedInAs(userId) && !isAnonymous();
        // Guests may delete their own preferences during account deletion,
        // but cannot read, create, or update cloud preferences.
        allow delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && !isAnonymous()
          && request.resource.data.keys().hasOnly(['values', 'updatedAt'])
          && request.resource.data.keys().hasAll(['values', 'updatedAt'])
          && request.resource.data.values is map
          && request.resource.data.values.keys().size() <= 20;
      }

      // No other nested collections/documents are writable.
    }

    // Public profile documents contain only fields explicitly approved for sharing.
    // Private email addresses and profile-photo base64 data remain in /users/{uid}.
    match /publicProfiles/{userId} {
      allow get: if true;
      allow list: if false;
      allow delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && !isAnonymous()
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'displayName', 'bio', 'photoUrl', 'photoData', 'showFavorites', 'favoriteGames',
          'followerCount', 'followingCount', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'showFavorites', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.showFavorites is bool
        && request.resource.data.updatedAt == request.time
        && (!('username' in request.resource.data)
          || (request.resource.data.username is string
            && request.resource.data.username.size() >= 3
            && request.resource.data.username.size() <= 20
            && request.resource.data.username.matches('[A-Za-z0-9][A-Za-z0-9_]{2,19}')))
        && (!('bio' in request.resource.data)
          || (request.resource.data.bio is string
            && request.resource.data.bio.size() <= 160))
        && (!('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 2048))
        && (!('photoData' in request.resource.data)
          || (request.resource.data.photoData is string
            && request.resource.data.photoData.size() <= 180000))
        && (!('favoriteGames' in request.resource.data)
          || (request.resource.data.favoriteGames is list
            && request.resource.data.favoriteGames.size() <= 30))
        && (!('followerCount' in request.resource.data)
          || (request.resource.data.followerCount is int
            && request.resource.data.followerCount >= 0))
        && (!('followingCount' in request.resource.data)
          || (request.resource.data.followingCount is int
            && request.resource.data.followingCount >= 0));
    }


    // Follow edges are visible only to the follower and the followed account.
    // The recursive rule supports the app's collection-group query filtered by
    // targetUid == request.auth.uid, without exposing the entire social graph.
    match /{path=**}/following/{targetUid} {
      allow read: if request.auth != null
        && (resource.data.uid == request.auth.uid
          || resource.data.targetUid == request.auth.uid);
    }

    match /userFollows/{followerUid}/following/{targetUid} {
      allow read: if signedInAs(followerUid)
        || (request.auth != null && resource.data.targetUid == request.auth.uid);
      allow create: if signedInAs(followerUid)
        && followerUid != targetUid
        && request.resource.data.keys().hasOnly(['uid', 'targetUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'targetUid', 'createdAt'])
        && request.resource.data.uid == followerUid
        && request.resource.data.targetUid == targetUid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedInAs(followerUid)
        || (request.auth != null && resource.data.targetUid == request.auth.uid);
      allow update: if false;
    }


    // Username keys are normalized to lowercase by the app. Clients can reserve
    // a free key once; only its owner may release it. Enumeration is disabled.
    match /usernames/{usernameKey} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && !isAnonymous()
        && usernameKey.matches('[a-z0-9][a-z0-9_]{2,19}')
        && request.resource.data.keys().hasOnly(['uid', 'username', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'username', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.lower() == usernameKey
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Private one-to-one conversations. Inbox queries must constrain participants
    // to the signed-in UID; only a mutually-following pair can start/send messages.
    match /conversations/{conversationId} {
      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || (resource.data.participants is list
            && resource.data.participants.hasAny([request.auth.uid])));
      allow list: if request.auth != null
        && resource.data.participants is list
        && resource.data.participants.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && !isAnonymous()
        && request.resource.data.keys().hasOnly([
          'participants', 'lastMessage', 'lastSenderUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'participants', 'lastMessage', 'lastSenderUid', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.participants.hasAny([request.auth.uid])
        && mutuallyFollowing(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        )
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 180
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && resource.data.participants is list
        && resource.data.participants.hasAny([request.auth.uid])
        && mutuallyFollowing(resource.data.participants[0], resource.data.participants[1])
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastSenderUid', 'updatedAt'])
        && request.resource.data.lastSenderUid == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 180
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        function conversationParticipants() {
          return getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.participants.hasAny([request.auth.uid]);
        allow create: if request.auth != null
          && !isAnonymous()
          && conversationParticipants() is list
          && conversationParticipants().hasAny([request.auth.uid])
          && conversationParticipants().size() == 2
          && mutuallyFollowing(
            conversationParticipants()[0],
            conversationParticipants()[1]
          )
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'createdAt', 'readBy'])
          && request.resource.data.keys().hasAll(['senderUid', 'text', 'createdAt', 'readBy'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          && request.resource.data.readBy is list
          && request.resource.data.readBy.size() == 1
          && request.resource.data.readBy[0] == request.auth.uid;
        allow update: if request.auth != null
          && get(/databases/$(database)/documents/conversations/$(conversationId))
            .data.participants.hasAny([request.auth.uid])
          && resource.data.senderUid != request.auth.uid
          && resource.data.readBy is list
          && resource.data.readBy.size() == 1
          && request.resource.data.readBy is list
          && request.resource.data.readBy.size() == 2
          && request.resource.data.readBy.hasAll([resource.data.senderUid, request.auth.uid])
          && request.resource.data.readAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'readAt']);
        allow delete: if false;
      }
    }

    // Game IDs are SHA-256 hashes generated from stable game identity fields.
    function validGameMetricId(gameId) {
      return gameId.size() == 64 && gameId.matches('[0-9a-f]{64}');
    }

    match /gameMetrics/{gameId}/views/{userId} {
      // Public summaries; writes are restricted to the matching Firebase UID.
      allow read: if validGameMetricId(gameId);
      // The UID document path enforces one immutable view per account/guest install.
      // Requiring request.time ensures createdAt is a Firestore server timestamp.
      allow create: if validGameMetricId(gameId)
        && signedInAs(userId)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /gameMetrics/{gameId}/downloads/{userId} {
      allow read: if validGameMetricId(gameId);
      // Count one confirmed download action per Firebase account or guest install.
      // The UID document path prevents duplicate counting for the same user/game.
      allow create: if validGameMetricId(gameId)
        && signedInAs(userId)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Collection-group queries need a recursive match. Keep this read-only;
    // rating writes remain restricted by the game-specific rule below.
    match /{path=**}/ratings/{userId} {
      allow read: if true;
    }

    match /gameMetrics/{gameId}/ratings/{userId} {
      // Ratings are intentionally public app engagement data. This also permits
      // a single collection-group query for the signed-in user's own rating history.
      allow read: if true;
      // Registered users own one rating per game and may update its value.
      // Anonymous visitors are explicitly denied.
      allow create, update: if validGameMetricId(gameId)
        && signedInAs(userId)
        && !isAnonymous()
        && request.resource.data.keys().hasOnly(['uid', 'rating', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'rating', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.updatedAt == request.time;
      allow delete: if validGameMetricId(gameId)
        && signedInAs(userId)
        && !isAnonymous();
    }

    // Everything else stays denied by default.
  }
}