rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validGuestProfile() {
      return request.resource.data.keys().hasOnly([
          'uid', 'isAnonymous', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'isAnonymous', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.isAnonymous == true;
    }

    // Anonymous sessions may keep only a minimal, self-owned profile and a
    // bounded preferences map. They cannot create arbitrary nested documents.
    match /users/{userId} {
      allow read, delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && (
          (isAnonymous() && validGuestProfile())
          || (!isAnonymous()
            && request.resource.data.keys().hasOnly([
              'uid', 'isAnonymous', 'createdAt', 'updatedAt',
              'email', 'displayName', 'photoUrl', 'bio', 'photoData',
              'publicProfile', 'showFavorites'
            ])
            && request.resource.data.keys().size() <= 11
            && (!('displayName' in request.resource.data)
              || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 40))
            && (!('bio' in request.resource.data)
              || (request.resource.data.bio is string
                && request.resource.data.bio.size() <= 160))
            && (!('photoData' in request.resource.data)
              || (request.resource.data.photoData is string
                && request.resource.data.photoData.size() <= 600000))
            && (!('publicProfile' in request.resource.data)
              || request.resource.data.publicProfile is bool)
            && (!('showFavorites' in request.resource.data)
              || request.resource.data.showFavorites is bool)
            )
        );

      match /settings/preferences {
        // Preferences are cloud-synced only for non-anonymous accounts.
        allow read: if signedInAs(userId) && !isAnonymous();
        // Guests may delete their own preferences during account deletion,
        // but cannot read, create, or update cloud preferences.
        allow delete: if signedInAs(userId);
        allow create, update: if signedInAs(userId)
          && !isAnonymous()
          && request.resource.data.keys().hasOnly(['values', 'updatedAt'])
          && request.resource.data.keys().hasAll(['values', 'updatedAt'])
          && request.resource.data.values is map
          && request.resource.data.values.keys().size() <= 20;
      }

      // No other nested collections/documents are writable.
    }

    // Public profile documents contain only fields explicitly approved for sharing.
    // Private email addresses and profile-photo base64 data remain in /users/{uid}.
    match /publicProfiles/{userId} {
      allow get: if true;
      allow list: if false;
      allow delete: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && !isAnonymous()
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'bio', 'photoUrl', 'photoData', 'showFavorites', 'favoriteGames', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'showFavorites', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.showFavorites is bool
        && request.resource.data.updatedAt == request.time
        && (!('bio' in request.resource.data)
          || (request.resource.data.bio is string
            && request.resource.data.bio.size() <= 160))
        && (!('photoUrl' in request.resource.data)
          || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 2048))
        && (!('photoData' in request.resource.data)
          || (request.resource.data.photoData is string
            && request.resource.data.photoData.size() <= 600000))
        && (!('favoriteGames' in request.resource.data)
          || (request.resource.data.favoriteGames is list
            && request.resource.data.favoriteGames.size() <= 30));
    }


    // A follow edge is owned by its follower. Public read access exposes only
    // the social graph metadata, never private account documents.
    match /userFollows/{followerUid}/following/{targetUid} {
      allow read: if request.auth != null;
      allow create: if signedInAs(followerUid)
        && followerUid != targetUid
        && request.resource.data.keys().hasOnly(['uid', 'targetUid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'targetUid', 'createdAt'])
        && request.resource.data.uid == followerUid
        && request.resource.data.targetUid == targetUid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedInAs(followerUid)
        || (request.auth != null && resource.data.targetUid == request.auth.uid);
      allow update: if false;
    }

    // Game IDs are SHA-256 hashes generated from stable game identity fields.
    function validGameMetricId(gameId) {
      return gameId.size() == 64 && gameId.matches('[0-9a-f]{64}');
    }

    match /gameMetrics/{gameId}/views/{userId} {
      // Public summaries; writes are restricted to the matching Firebase UID.
      allow read: if validGameMetricId(gameId);
      // The UID document path enforces one immutable view per account/guest install.
      // Requiring request.time ensures createdAt is a Firestore server timestamp.
      allow create: if validGameMetricId(gameId)
        && signedInAs(userId)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /gameMetrics/{gameId}/downloads/{userId} {
      allow read: if validGameMetricId(gameId);
      // Count one confirmed download action per Firebase account or guest install.
      // The UID document path prevents duplicate counting for the same user/game.
      allow create: if validGameMetricId(gameId)
        && signedInAs(userId)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /gameMetrics/{gameId}/ratings/{userId} {
      // Ratings are intentionally public app engagement data. This also permits
      // a single collection-group query for the signed-in user's own rating history.
      allow read: if true;
      // Registered users own one rating per game and may update its value.
      // Anonymous visitors are explicitly denied.
      allow create, update: if validGameMetricId(gameId)
        && signedInAs(userId)
        && !isAnonymous()
        && request.resource.data.keys().hasOnly(['uid', 'rating', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'rating', 'updatedAt'])
        && request.resource.data.uid == userId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.updatedAt == request.time;
      allow delete: if validGameMetricId(gameId)
        && signedInAs(userId)
        && !isAnonymous();
    }

    // Everything else stays denied by default.
  }
}