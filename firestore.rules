rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validScore(score) {
      return score is int && score >= 1 && score <= 5;
    }

    function validArticleMetadata(data) {
      return data.name is string
        && data.url is string
        && data.updatedAt is int;
    }

    match /articles/{articleId} {
      allow read: if true;

      function validFirstView() {
        return request.resource.data.keys().hasOnly([
            'views', 'name', 'url', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'views', 'name', 'url', 'updatedAt'
          ])
          && request.resource.data.views == 1
          && validArticleMetadata(request.resource.data);
      }

      function validFirstRating() {
        let ratingPath = /databases/$(database)/documents/articles/$(articleId)/ratings/$(request.auth.uid);
        return existsAfter(ratingPath)
          && request.resource.data.keys().hasOnly([
            'views', 'name', 'url', 'ratingCount', 'ratingSum', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'views', 'name', 'url', 'ratingCount', 'ratingSum', 'updatedAt'
          ])
          && request.resource.data.views == 0
          && request.resource.data.ratingCount == 1
          && validScore(getAfter(ratingPath).data.score)
          && request.resource.data.ratingSum == getAfter(ratingPath).data.score
          && validArticleMetadata(request.resource.data)
          && request.resource.data.ratingCount is int
          && request.resource.data.ratingSum is int;
      }

      function validViewIncrement() {
        return request.resource.data.views is int
          && request.resource.data.views == resource.data.get('views', 0) + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'views', 'updatedAt'
          ])
          && request.resource.data.updatedAt is int;
      }

      function validRatingAggregate() {
        let ratingPath = /databases/$(database)/documents/articles/$(articleId)/ratings/$(request.auth.uid);
        let oldScore = exists(ratingPath)
          ? get(ratingPath).data.get('score', 0)
          : 0;
        let newScore = getAfter(ratingPath).data.score;
        return existsAfter(ratingPath)
          && validScore(newScore)
          && oldScore is int
          && request.resource.data.views == resource.data.get('views', 0)
          && request.resource.data.ratingCount
            == resource.data.get('ratingCount', 0) + (oldScore == 0 ? 1 : 0)
          && request.resource.data.ratingSum
            == resource.data.get('ratingSum', 0) - oldScore + newScore
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ratingCount', 'ratingSum', 'updatedAt'
          ])
          && request.resource.data.ratingCount is int
          && request.resource.data.ratingSum is int
          && request.resource.data.updatedAt is int;
      }

      allow create: if signedIn()
        && (validFirstView() || validFirstRating());

      allow update: if signedIn()
        && (validViewIncrement() || validRatingAggregate());

      allow delete: if false;

      match /ratings/{userId} {
        function articlePath() {
          return /databases/$(database)/documents/articles/$(articleId);
        }

        function ratingPath() {
          return /databases/$(database)/documents/articles/$(articleId)/ratings/$(userId);
        }

        function validRatingPayload() {
          return request.resource.data.keys().hasOnly(['score', 'updatedAt'])
            && request.resource.data.keys().hasAll(['score', 'updatedAt'])
            && validScore(request.resource.data.score)
            && request.resource.data.updatedAt is int;
        }

        function validParentAggregateForExistingArticle() {
          let oldScore = exists(ratingPath())
            ? get(ratingPath()).data.get('score', 0)
            : 0;
          let before = get(articlePath()).data;
          let after = getAfter(articlePath()).data;
          return oldScore is int
            && after.ratingCount
              == before.get('ratingCount', 0) + (oldScore == 0 ? 1 : 0)
            && after.ratingSum
              == before.get('ratingSum', 0) - oldScore + request.resource.data.score
            && after.views == before.get('views', 0)
            && after.diff(before).affectedKeys().hasOnly([
              'ratingCount', 'ratingSum', 'updatedAt'
            ]);
        }

        function validParentAggregateForNewArticle() {
          let after = getAfter(articlePath()).data;
          return after.views == 0
            && after.ratingCount == 1
            && after.ratingSum == request.resource.data.score
            && after.keys().hasOnly([
              'views', 'name', 'url', 'ratingCount', 'ratingSum', 'updatedAt'
            ])
            && after.keys().hasAll([
              'views', 'name', 'url', 'ratingCount', 'ratingSum', 'updatedAt'
            ])
            && validArticleMetadata(after);
        }

        allow read: if signedIn() && request.auth.uid == userId;

        allow create, update: if signedIn()
          && request.auth.uid == userId
          && validRatingPayload()
          && existsAfter(articlePath())
          && (
            (exists(articlePath()) && validParentAggregateForExistingArticle())
            || (!exists(articlePath()) && validParentAggregateForNewArticle())
          );

        allow delete: if false;
      }
    }
  }
}